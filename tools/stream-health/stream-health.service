[Unit]
Description=Quiet overnight stream preset health check

[Service]
Type=oneshot
WorkingDirectory=%h/git/mix.4st.uk
ExecStart=/usr/bin/flock --nonblock %S/stream-health/scan.lock /usr/bin/node %h/git/mix.4st.uk/tools/stream-health/scan.mjs
StateDirectory=stream-health
StateDirectoryMode=0700
UMask=0077
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=2h
# Run as the ordinary user: Postfix submission needs setgid postdrop access.
